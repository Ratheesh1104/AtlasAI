# Copy to .env.development or .env.production (or a plain .env) and fill in.
# DJANGO_ENV picks which settings module loads (config/settings/dev.py or prod.py)
# and, by default, which .env.<name> file is read (.env.development / .env.production).
DJANGO_ENV=development

# ---------- Core Django ----------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# ---------- Database ----------
# SQLite (default, good for dev):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (recommended for prod):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# ---------- CORS ----------
# "*" allows any origin (fine for local dev). Comma-separated list of exact
# origins for production, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---------- LLM provider ----------
# Which provider atlas_api/llm/factory.py should use: "gemini" or "openai_compatible"
LLM_PROVIDER=gemini
# Optional global override of the model name; providers fall back to their own default.
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=60

# Gemini (https://aistudio.google.com/apikey — free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Any OpenAI-compatible endpoint (OpenAI itself, Azure OpenAI proxy, Emergent, etc.)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4.1
